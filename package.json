{
  "name": "claude-telegram-alerts",
  "version": "1.0.0",
  "description": "MCP server for Claude Code status alerts via Telegram - get notified when Claude needs input or completes tasks",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "telegram",
    "claude-code",
    "notifications",
    "alerts",
    "status"
  ],
  "author": "Anthony Potts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthony-potts/claude-telegram-alerts.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "node-telegram-bot-api": "^0.66.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/node-telegram-bot-api": "^0.64.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
